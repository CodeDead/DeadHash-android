    <string name="text_about">DeadHash 由 DeadLine 创建。此应用可用于生成文件和字符串的哈希值。\n\n此版本不包含任何广告或跟踪设备。DeadHash 不请求任何权限。\n\n所有图像均由 Google 提供。\n\nCopyright © 2026 CodeDead</string>
    <string name="text_compare">比较：</string>
    <string name="text_compare_hash">比较哈希值</string>
