<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/Encryption_title"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignTop="@+id/Copy_Data"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/Compare_check_image"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            tools:ignore="RelativeOverlap" />

        <ImageButton
            android:id="@+id/Compare_check_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@+id/Copy_Data"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/text_compare_hash"
            android:padding="12dp"
            android:src="@drawable/ic_compare_uncheck"
            app:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/Copy_Data"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copy_data"
            android:padding="12dp"
            android:src="@drawable/ic_content_copy"
            app:tint="?attr/colorControlNormal" />

        <TextView
            android:id="@+id/Encryption_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/Copy_Data"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
