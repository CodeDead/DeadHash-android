<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".gui.MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/EdtText_Content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_content_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TableLayout
            android:id="@+id/layout_compare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/EdtText_Content"
            android:paddingTop="5dp">

            <TableRow>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_compare"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/Edit_TextCompare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/text_compare_hint"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </TableRow>
        </TableLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layout_compare"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BtnClearTextResults"
                style="@style/Widget.DeadHash.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/clear"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonGenerateText"
                style="@style/Widget.DeadHash.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_generate" />

        </LinearLayout>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <ProgressBar
        android:id="@+id/PgbText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/text_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="88dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/FabExportText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/export"
            android:src="@drawable/ic_export"
            android:visibility="gone"
            app:backgroundTint="@color/export_fab_background"
            app:tint="@color/export_fab_icon" />

    </FrameLayout>

</LinearLayout>
